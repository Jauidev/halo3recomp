# Halo 3 (generated by tools/slot.py). XPORT_TITLE_ID: from the XEX, it keys the pipeline cache
# on disk. XPORT_XEX_MEDIA / XPORT_XEX_VERSION: the XEX the launcher accepts (0: any).
set(XPORT_TITLE_ID 0x4D5307E6)
set(XPORT_XEX_MEDIA 0x3DFC2730)
set(XPORT_XEX_VERSION 0x00000005)
# The app's name on the phone (tools/build-apk.sh).
set(XPORT_APP_LABEL "Halo 3")
# The version the phone and the launcher show (tools/build-apk.sh: the manifest's versionName).
set(XPORT_APP_VERSION "1.0.0")
# The launcher's colours (0xRRGGBB), blue mixed with green, to go with its own
# background, LAUNCHER/FONDO.png (an original abstract picture: navy to teal, aurora light, hexagons):
# the accent (selection, buttons) is a turquoise green, the glass tint a deep ocean blue.
set(XPORT_LAUNCHER_ACCENT 0x1FC7A8)
set(XPORT_LAUNCHER_TINT 0x0A1A2E)
# Waves' audio DLLs (WaveShell-Xbox.dll, WavesLibDLL.dll, waves/L360.dll, waves/Q10.dll), recompiled
# like the game (tools/xport.py on each, then tools/slot_dlls.py): XPORT_EXTRA_PPC_DIRS.
include(${CMAKE_CURRENT_LIST_DIR}/dlls/dlls.cmake OPTIONAL)
